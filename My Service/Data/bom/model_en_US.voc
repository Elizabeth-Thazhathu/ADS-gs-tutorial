# _005b6t744.et_getting_started.my_service.data.Weather
_005b6t744.et_getting_started.my_service.data.Weather#concept.label = weather
_005b6t744.et_getting_started.my_service.data.Weather.Weather(long,boolean,_005b6t744.et_getting_started.my_service.data.Temperature)#phrase.navigation = a new {weather} where {0, rain forecast} {1, storm alert} {2, temperature}
_005b6t744.et_getting_started.my_service.data.Weather.rainForecast#phrase.action = set the rain forecast of {this} to {rain forecast}
_005b6t744.et_getting_started.my_service.data.Weather.rainForecast#phrase.addition_setter = add {rain forecast} to the rain forecast of {this}
_005b6t744.et_getting_started.my_service.data.Weather.rainForecast#phrase.navigation = {rain forecast} of {this}
_005b6t744.et_getting_started.my_service.data.Weather.rainForecast#phrase.subtraction_setter = subtract {rain forecast} from the rain forecast of {this}
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.action[0] = {this} gets storm alert only if {storm alert}
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.action[1] = make it {storm alert} that {this} is storm alert
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.action[1].deprecated = true
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.navigation = {this} is storm alert
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.negative_predicate = {this} is not storm alert
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.negative_predicate_setter = {this} does not get storm alert
_005b6t744.et_getting_started.my_service.data.Weather.stormAlert#phrase.positive_predicate_setter = {this} gets storm alert
